{
  "name": "local-vot",
  "productName": "Local VOT",
  "version": "0.5.0",
  "description": "Закадровый перевод локальных видео через переводчик Яндекса",
  "main": "src/main/index.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "node --test --experimental-test-module-mocks \"tests/*.test.mjs\"",
    "dist": "node scripts/embed-credentials.mjs && electron-builder --win --x64 --publish never && node scripts/pack-portable.mjs"
  },
  "author": {
    "name": "SolidSnake"
  },
  "license": "MIT",
  "dependencies": {
    "@vot.js/core": "^3.1.6",
    "@vot.js/node": "^3.1.6"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SolidSnake1765/local-vot.git"
  },
  "homepage": "https://github.com/SolidSnake1765/local-vot",
  "build": {
    "appId": "io.github.solidsnake1765.localvot",
    "productName": "Local VOT",
    "copyright": "© 2026 SolidSnake",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon-512.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Local VOT",
      "installerLanguages": [
        "ru_RU"
      ],
      "language": "1049",
      "include": "build/installer.nsh",
      "artifactName": "Local-VOT-${version}-setup.${ext}"
    },
    "electronLanguages": [
      "ru",
      "en-US"
    ],
    "extraResources": [
      {
        "from": "assets/icon-512.png",
        "to": "icon.png"
      },
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg"
      }
    ]
  }
}
