# Данные приложения с oauth.yandex.ru (страница приложения → ClientID и Client secret).
# Скопируйте этот файл в .env и вставьте значения после знака «=» без пробелов и кавычек.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Данные клиента «Desktop app» с console.cloud.google.com (Google Auth platform → Clients) — для Google Диска.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
